# Image versions are pinned to supported major/minor releases. Review before upgrades.
OLLAMA_IMAGE=ollama/ollama:0.11.4
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.6.35
OLLAMA_PORT=11434
OPEN_WEBUI_PORT=3000
OLLAMA_KEEP_ALIVE=24h
WEBUI_SECRET_KEY=change-this-to-a-long-random-value
WEBUI_AUTH=true
WEBUI_ENABLE_SIGNUP=false
TZ=UTC

# Optional vLLM profile values.
VLLM_IMAGE=vllm/vllm-openai:v0.10.1.1
VLLM_PORT=8000
VLLM_MODEL=openai/gpt-oss-20b

