{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["vite.config.ts", "worker.ts", "mcp/**/*.ts", "cli/**/*.ts", "tests/**/*.ts", "src/data/**/*.ts", "src/lib/**/*.ts"]
}
