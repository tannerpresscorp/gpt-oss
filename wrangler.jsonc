{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gpt-oss-roadmap",
  "main": "worker.ts",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
